%% UniFi Alarm Panel: system architecture (editable source; GitHub renders it)
flowchart LR
  subgraph UniFi["UniFi console (Protect)"]
    S1["UP-Sense<br/>(door mode + magnet)"]
    S2["UP-Sense<br/>(motion mode)"]
    GW["Access point<br/>(Bluetooth host)"]
    CAM["Cameras"]
    AM["Alarm Manager"]
    S1 -->|Bluetooth| GW
    S2 -->|Bluetooth| GW
    GW --> AM
    CAM --> AM
  end

  subgraph Server["unifi-alarm-panel (Docker or systemd)"]
    API["Arm/Disarm Backend<br/>(state machine + API)"]
    DB[("SQLite: PIN hashes,<br/>armed state, audit log,<br/>encrypted settings")]
    API --- DB
  end

  IPAD["Tablet kiosk<br/>(PIN wall panel)"]

  IPAD -->|"enter PIN: arm / disarm"| API
  AM -->|"outbound webhook:<br/>sensor tripped"| API
  API -->|"fetch snapshot / live link"| CAM
  API -->|"alert when armed"| ADMIN["Slack / ntfy"]
  ADM["Admin browser"] -->|"settings, PINs, audit"| API
