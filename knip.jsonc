{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["public/panel.js", "scripts/*.{ts,mts}", "e2e/**/*.ts"],
  "project": ["**/*.{ts,tsx,mts,js,mjs}"],
  // shadcn component files export every subpart by convention; the icon modules are still checked.
  "ignore": ["components/ui/*.tsx"],
  "ignoreExportsUsedInFile": true,
  "exclude": ["types"],
  // Imported from app/globals.css, which knip does not parse.
  "ignoreDependencies": ["shadcn", "tailwindcss", "tw-animate-css"],
  // Host tool, run by the screenshots script, not an npm package.
  "ignoreBinaries": ["ffmpeg"],
}
