{
  "name": "unifi-alarm-panel",
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FelixLeChat/unifi-alarm-panel.git"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "shots": "playwright test -c playwright.visual.config.ts",
    "shots:baseline": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "pin:add": "tsx scripts/create-pin.ts",
    "sensor:trip": "tsx --env-file-if-exists=.env scripts/simulate-sensor.ts",
    "protect:mock": "tsx --env-file-if-exists=.env scripts/mock-protect-server.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@material-symbols-svg/react": "^0.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "unifi-protect": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "knip": "^5.88.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
