# Copy to .env and fill in. Never commit .env.
#
# Only what protects everything else lives here. The UniFi console, alert
# channels, kiosk options and delays are set in the admin UI (first-run setup
# wizard, then Settings) and stored in the database.

# --- Core ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# SQLite file path. Default: ./data/alarm.db. The systemd install sets
# /var/lib/unifi-alarm-panel/alarm.db; Docker sets /data/alarm.db in the image,
# so leave this unset in a .env used with docker compose.
# DATABASE_PATH=/var/lib/unifi-alarm-panel/alarm.db

# --- Auth ---
# Token for /admin and every /api/admin/* route (header: X-Admin-Token).
# Generate: openssl rand -hex 24
ADMIN_TOKEN=

# Shared secret UniFi Alarm Manager sends on its outbound webhook
# (header: X-Alarm-Secret, or ?token= query param).
# Generate: openssl rand -hex 24
WEBHOOK_SHARED_SECRET=

# Encrypts the credentials stored in the database (Protect API key, SuperAdmin
# password, Slack webhook and token, Telegram bot token). 32 bytes, base64.
# Generate: openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored credentials have to be re-entered.
SECRETS_KEY=

# --- Auto-update ---
# Hourly check against this repo's GitHub Releases, shown on the admin Tasks
# screen. Public releases need no token. For a private fork, put a token in
# /etc/unifi-alarm-panel-github-token (see deploy/bootstrap.sh).
UPDATE_CHECK_REPO=FelixLeChat/unifi-alarm-panel

# --- Upgrading from an env-only setup (optional) ---
# Read once, on the first boot with an empty settings table, and copied into
# the database. Ignored after that: edit them in the admin UI. Set SECRETS_KEY
# first so the credentials can be imported.
#
# PROTECT_API_BASE_URL=https://unifi.local.example
# PROTECT_API_KEY=
# PROTECT_HOST=unifi.local.example
# PROTECT_ADMIN_USERNAME=
# PROTECT_ADMIN_PASSWORD=
# PROTECT_CA_CERT=/etc/unifi-alarm-panel/console-ca.pem
# PROTECT_INSECURE_TLS=false
# PROTECT_LIVE_VIEW_URL_TEMPLATE=
# PROTECT_DEFAULT_CAMERA_ID=
# PROTECT_CONSOLE_CAMERAS_URL=
# GO2RTC_API_BASE_URL=http://127.0.0.1:1984
# ALERT_TIMEZONE=UTC
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# NTFY_URL=
# NTFY_TOPIC=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SIGNAL_API_URL=http://signal-cli:8080
# SIGNAL_NUMBER=+15145550100
# SIGNAL_RECIPIENTS=+15145550101,group.abc
# PANEL_WEATHER_LAT=
# PANEL_WEATHER_LON=
# PANEL_AUDIO_ENABLED=true
# PANEL_QUIET_HOURS_START=22
# PANEL_QUIET_HOURS_END=6
# DEFAULT_EXIT_DELAY_SEC=30
# DEFAULT_ENTRY_DELAY_SEC=30
# DEFAULT_EXTERNAL_ARM_SYNC_DELAY_SEC=5
